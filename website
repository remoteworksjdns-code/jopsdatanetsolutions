/* Jops Datanet Solutions - site styles */
:root {
  --bg: #222629;
  --bg-2: #1a1d20;
  --panel: #2a2f33;
  --line: #363c41;
  --text: #e9edf0;
  --muted: #9aa4ad;
  --blue: #2e8bff;
  --blue-2: #1663c7;
  --orange: #f06a2b;
  --radius: 14px;
  --max: 1160px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 76px; }
body {
  font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg); color: var(--text); line-height: 1.65; font-size: 16px;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
.wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
.eyebrow {
  font-size: 12.5px; letter-spacing: .22em; text-transform: uppercase;
  color: var(--blue); font-weight: 600; margin-bottom: 14px;
}
h1, h2, h3 { line-height: 1.2; font-weight: 600; }
h2 { font-size: clamp(28px, 3.4vw, 40px); margin-bottom: 16px; }
.lead { color: var(--muted); font-size: 17px; max-width: 640px; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 13px 24px; border-radius: 999px; font-weight: 500; font-size: 15px;
  border: 1px solid transparent; cursor: pointer; transition: .2s ease; font-family: inherit;
}
.btn-primary { background: var(--blue); color: #fff; }
.btn-primary:hover { background: #4a9cff; transform: translateY(-1px); }
.btn-ghost { border-color: var(--line); color: var(--text); background: transparent; }
.btn-ghost:hover { border-color: var(--blue); color: #fff; }
.btn svg { width: 18px; height: 18px; flex: none; }

/* Header */
header {
  position: sticky; top: 0; z-index: 50;
  background: rgba(34, 38, 41, .88); backdrop-filter: blur(10px);
  border-bottom: 1px solid transparent; transition: border-color .2s;
}
header.scrolled { border-bottom-color: var(--line); }
.nav { display: flex; align-items: center; justify-content: space-between; height: 72px; }
.brand { display: flex; align-items: center; gap: 12px; }
.brand img { width: 44px; height: 44px; }
.brand span { font-size: 13.5px; letter-spacing: .24em; font-weight: 500; text-transform: uppercase; }
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; }
.nav-links a { color: var(--muted); font-size: 15px; transition: color .2s; }
.nav-links a:hover { color: var(--text); }
.nav-links .btn { padding: 9px 20px; color: #fff; }
.menu-btn { display: none; background: none; border: 0; color: var(--text); cursor: pointer; padding: 8px; }
.menu-btn svg { width: 26px; height: 26px; }

/* Hero */
.hero { position: relative; overflow: hidden; padding: 72px 0 96px; }
.hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 40px; }
.hero h1 { font-size: clamp(36px, 5.2vw, 60px); font-weight: 600; margin-bottom: 22px; letter-spacing: -.01em; }
.hero h1 em { font-style: normal; color: var(--blue); }
.hero .lead { margin-bottom: 34px; }
.hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; }
.hero-art { position: relative; display: flex; justify-content: flex-end; }
.hero-art picture { display: block; }
/* Emblem scales with the screen: never smaller than 200px, never larger than 560px,
   and in between it follows the viewport width (and height on short screens). */
.hero-art img {
  width: clamp(200px, min(38vw, 62vh), 560px);
  height: auto; aspect-ratio: 1 / 1;
  -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 52%, transparent 71%);
          mask-image: radial-gradient(circle at 50% 50%, #000 52%, transparent 71%);
  animation: float 7s ease-in-out infinite;
}
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.badges { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 36px; margin-top: 46px; padding-top: 28px; border-top: 1px solid var(--line); }
.badge-item strong { display: block; font-size: 26px; font-weight: 600; color: #fff; }
.badge-item span { font-size: 13.5px; color: var(--muted); display: block; line-height: 1.45; }

/* Sections */
section { padding: 96px 0; }
.alt { background: var(--bg-2); }
.section-head { margin-bottom: 52px; }

/* Services */
.services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.card {
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 30px 28px; transition: .25s ease; position: relative; overflow: hidden;
}
.card::after {
  content: ""; position: absolute; left: 0; top: 0; height: 3px; width: 0;
  background: linear-gradient(90deg, var(--blue), var(--orange)); transition: width .35s ease;
}
.card:hover { transform: translateY(-4px); border-color: #45505a; }
.card:hover::after { width: 100%; }
.icon {
  width: 50px; height: 50px; border-radius: 12px; display: grid; place-items: center;
  background: rgba(46, 139, 255, .12); color: var(--blue); margin-bottom: 20px;
}
.icon svg { width: 26px; height: 26px; }
.card h3 { font-size: 19px; margin-bottom: 10px; }
.card p { color: var(--muted); font-size: 15px; }

/* About */
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
.about-text p { color: var(--muted); margin-bottom: 18px; }
.about-text p strong { color: var(--text); font-weight: 500; }
.points { display: grid; gap: 16px; }
.point {
  display: flex; gap: 18px; align-items: flex-start;
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px 24px;
}
.point .num { font-size: 30px; font-weight: 600; color: var(--blue); line-height: 1; min-width: 72px; }
.point.orange .num { color: var(--orange); }
.point h3 { font-size: 16.5px; margin-bottom: 4px; }
.point p { color: var(--muted); font-size: 14.5px; }

/* Contact */
.contact-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 40px; }
form { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field { margin-bottom: 16px; }
label { display: block; font-size: 13.5px; color: var(--muted); margin-bottom: 7px; }
input, select, textarea {
  width: 100%; padding: 12px 14px; border-radius: 10px; font-family: inherit; font-size: 15px;
  background: var(--bg-2); border: 1px solid var(--line); color: var(--text); transition: border-color .2s;
}
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--blue); }
textarea { min-height: 130px; resize: vertical; }
.hp { position: absolute; left: -9999px; }
.form-note { font-size: 13.5px; margin-top: 14px; min-height: 20px; }
.form-note.ok { color: #4fd18b; }
.form-note.err { color: #ff7b6b; }
.info { display: grid; gap: 14px; align-content: start; }
.info-item {
  display: flex; gap: 16px; align-items: flex-start;
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px;
}
.info-item .icon { margin: 0; width: 42px; height: 42px; flex: none; }
.info-item .icon svg { width: 21px; height: 21px; }
.info-item small { display: block; color: var(--muted); font-size: 13px; }
.info-item a, .info-item address { font-style: normal; font-size: 15px; word-break: break-word; }
.info-item a:hover { color: var(--blue); }
.map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); height: 210px; }
.map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(.35) invert(.9) hue-rotate(180deg); }

/* Footer */
footer { border-top: 1px solid var(--line); padding: 34px 0; color: var(--muted); font-size: 13.5px; }
.foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; }

/* WhatsApp float */
.wa-float {
  position: fixed; right: 22px; bottom: 22px; z-index: 60;
  width: 58px; height: 58px; border-radius: 50%; background: #25d366; color: #fff;
  display: grid; place-items: center; box-shadow: 0 8px 24px rgba(0,0,0,.35); transition: transform .2s;
}
.wa-float:hover { transform: scale(1.07); }
.wa-float svg { width: 30px; height: 30px; }

/* Reveal on scroll */
.reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
.reveal.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; transition: none; }
  .hero-art img { animation: none; }
}

/* Responsive */
@media (max-width: 960px) {
  .services { grid-template-columns: repeat(2, 1fr); }
  .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 40px; }
}
@media (max-width: 760px) {
  .hero { padding: 36px 0 72px; }
  .hero-grid { grid-template-columns: 1fr; }
  .hero-art { order: -1; justify-content: center; }
  .hero-art img { width: clamp(180px, min(64vw, 40vh), 340px); }
  .services { grid-template-columns: 1fr; }
  .badges { gap: 18px; }
  .badge-item strong { font-size: 20px; }
  .badge-item span { font-size: 12px; }
  .row { grid-template-columns: 1fr; gap: 0; }
  section { padding: 72px 0; }
  form { padding: 24px; }
  .menu-btn { display: block; }
  .nav-links {
    position: absolute; top: 72px; left: 0; right: 0; flex-direction: column; gap: 0;
    background: var(--bg); border-bottom: 1px solid var(--line); padding: 8px 24px 20px; display: none;
  }
  .nav-links.open { display: flex; }
  .nav-links li { width: 100%; }
  .nav-links a { display: block; padding: 12px 0; }
  .nav-links .btn { margin-top: 8px; justify-content: center; }
  .brand span { font-size: 11.5px; letter-spacing: .18em; }
}


